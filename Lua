-- [[ WATER TESTER: FIX RESPAWN (TOMBOL TIDAK HILANG) ]] --

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- 1. Setup GUI (PENTING: ResetOnSpawn = false agar tidak hilang saat mati)
local ScreenGui = PlayerGui:FindFirstChild("WaterTestGui")
if not ScreenGui then
    ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "WaterTestGui"
    ScreenGui.ResetOnSpawn = false -- Kunci biar tombol tetap ada saat respawn
    ScreenGui.Parent = PlayerGui
end

local Btn = ScreenGui:FindFirstChild("TestBtn") or Instance.new("TextButton", ScreenGui)
Btn.Name = "TestBtn"
Btn.Size = UDim2.new(0, 150, 0, 50)
Btn.Position = UDim2.new(0.5, 0, 0.1, 0)
Btn.Text = "instant kill: OFF"
Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
Btn.Draggable = true 

local isTesting = false
local connections = {}

-- 2. Fungsi Utama
local function toggleTest()
    isTesting = not isTesting
    local char = LocalPlayer.Character
    if not char then return end
    
    if isTesting then
        Btn.Text = "instant kill: ON"
        Btn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
        
        -- Loop agar tetap bekerja meskipun karakter baru saja respawn
        connections["Loop"] = RunService.Heartbeat:Connect(function(deltaTime)
            local currentCharacter = LocalPlayer.Character
            if not currentCharacter or not currentCharacter:FindFirstChild("HumanoidRootPart") then return end
            
            -- Anti Death
            local humanoid = currentCharacter:FindFirstChild("Humanoid")
            if humanoid then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
            end
            
            -- Noclip
            for _, part in pairs(currentCharacter:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            
            -- Gerakan Mulus (Tween-like)
            local rootPart = currentCharacter.HumanoidRootPart
            rootPart.Velocity = Vector3.new(0, 0, 0)
            
            local speedDown = 150 
            local speedForward = 150
            
            rootPart.CFrame = rootPart.CFrame + Vector3.new(0, -speedDown * deltaTime, 0) + (rootPart.CFrame.LookVector * (speedForward * deltaTime))
        end)
        
    else
        Btn.Text = "instant kill: OFF"
        Btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        
        if connections["Loop"] then
            connections["Loop"]:Disconnect()
            connections["Loop"] = nil
        end
        
        -- Kembalikan collide
        local charNow = LocalPlayer.Character
        if charNow then
            for _, part in pairs(charNow:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
            if charNow:FindFirstChild("Humanoid") then
                charNow.Humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
            end
        end
    end
end

Btn.MouseButton1Click:Connect(toggleTest)
